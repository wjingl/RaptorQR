{
  "name": "raptorqr-sender-manager",
  "version": "1.0.0",
  "description": "RaptorQR 发送端文件传出管理系统（内网部署，零外网依赖）",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node app/server.js",
    "dev": "node app/server.js",
    "test": "node --test \"test/*.test.js\"",
    "prep": "node scripts/prep.js",
    "build:receiver": "node receiver/build_receiver.js",
    "cli": "node scripts/cli.js",
    "package": "bash scripts/build_package.sh"
  },
  "dependencies": {
    "@depup/svg-captcha": "1.4.0-depup.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.0",
    "csrf": "^3.1.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.1",
    "express-session-better-sqlite3": "^1.2.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.0",
    "morgan": "^1.10.0",
    "rotating-file-stream": "^3.2.0"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  },
  "overrides": {
    "content-type": "1.0.5"
  }
}
